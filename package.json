{
    "name": "rain-sdk-v2",
    "version": "2.0.8",
    "type": "module",
    "description": "Rain SDK V2 — TypeScript SDK for Rain prediction markets on Arbitrum. Market creation, trading, liquidity, order book, split/merge, dispute, and smart account support.",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        }
    },
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "build": "tsc",
        "dev": "tsc -w",
        "prepublishOnly": "npm run build"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/UsamaShafique/rain-sdk-v2.git"
    },
    "keywords": [
        "web3",
        "account-abstraction",
        "smart-account",
        "rain",
        "viem",
        "alchemy"
    ],
    "author": "Rain Protocol",
    "license": "MIT",
    "peerDependencies": {
        "@account-kit/infra": "^4.48.0",
        "@account-kit/wallet-client": "^4.0.0",
        "@alchemy/aa-alchemy": "^3.0.0",
        "@alchemy/aa-core": "^3.0.0",
        "viem": "^2.0.0"
    },
    "peerDependenciesMeta": {
        "@account-kit/infra": {
            "optional": true
        },
        "@account-kit/wallet-client": {
            "optional": true
        },
        "@alchemy/aa-alchemy": {
            "optional": true
        },
        "@alchemy/aa-core": {
            "optional": true
        }
    },
    "dependencies": {
        "ethers": "^6.16.0",
        "socket.io-client": "^4.8.3"
    },
    "devDependencies": {
        "typescript": "^5.9.3",
        "viem": "^2.48.8"
    }
}